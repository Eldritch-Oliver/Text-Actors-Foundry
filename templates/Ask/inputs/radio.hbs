<fieldset class="prompt">
	<legend>
		{{ label }}
	</legend>
	{{#each options as |option|}}
		<label>
			<input
				type="radio"
				name="{{ ../key }}"
				value="{{ option.value }}"
				{{#if (eq ../defaultValue option.value)}}checked{{/if}}
				{{disabled option.disabled}}
			>
			{{ option.label }}
		</label>
	{{/each}}
</fieldset>
